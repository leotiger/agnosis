msgstr "Nombre"

#: includes/Artist/Admission.php:113
#: includes/Artist/AdmissionNotification.php:514
#: includes/Artist/AdmissionNotification.php:609
msgid "Bio"
msgstr "Biografía"

#: includes/Artist/Admission.php:122
#: includes/Artist/AdmissionNotification.php:524
#: includes/Artist/AdmissionNotification.php:619
msgid "Statement"
msgstr "Declaración"

#. translators: 1: field name (e.g. "Name", "Bio", "Message"), 2: maximum character count
#: includes/Artist/Admission.php:178 includes/Artist/ContactForm.php:203
#: includes/Network/ActivityPub.php:3964
#, php-format
msgid "%1$s must be %2$d characters or fewer."
msgstr "%1$s debe tener %2$d caracteres o menos."

#: includes/Artist/Admission.php:228 includes/Artist/JoinPage.php:217
msgid "Please select your language."
msgstr "Por favor, selecciona tu idioma."

#: includes/Artist/Admission.php:237
msgid "An account with this email address already exists."
msgstr "Ya existe una cuenta con esta dirección de correo electrónico."

#: includes/Artist/Admission.php:261
msgid "This email address belongs to an admitted artist."
msgstr "Esta dirección de correo electrónico pertenece a un artista admitido."

#: includes/Artist/Admission.php:262
msgid "An application for this email address is already pending."
msgstr ""
"Ya hay una solicitud pendiente para esta dirección de correo electrónico."

#: includes/Artist/Admission.php:609 includes/Artist/Admission.php:717
msgid "Application not found."
msgstr "Solicitud no encontrada."

#: includes/Artist/Admission.php:649
msgid "Only admitted artists can vouch."
msgstr "Solo los artistas admitidos pueden dar aval."

#: includes/Artist/Admission.php:659
msgid "Admin access required."
msgstr "Se requiere acceso de administrador."

#: includes/Artist/Admission.php:698
msgid ""
"Community voting is disabled on this site. Applications are reviewed "
"directly by an admin."
msgstr ""
"La votación comunitaria está deshabilitada en este sitio. Las solicitudes "
"las revisa directamente un administrador."

#: includes/Artist/Admission.php:731
msgid "You cannot vote on your own application."
msgstr "No puedes votar tu propia solicitud."

#: includes/Artist/AdmissionConfirm.php:64
#: includes/Newsletter/SubscriptionConfirm.php:82
#: includes/Newsletter/SubscriptionConfirm.php:139
msgid "Invalid or incomplete link."
msgstr "Enlace inválido o incompleto."

#: includes/Artist/AdmissionConfirm.php:80
#: includes/Newsletter/SubscriptionConfirm.php:158
msgid "This confirmation link is invalid or has already been used."
msgstr "Este enlace de confirmación no es válido o ya se ha usado."

#: includes/Artist/AdmissionConfirm.php:113
msgid "Confirming your application…"
msgstr "Confirmando tu solicitud…"

#: includes/Artist/AdmissionConfirm.php:114
msgid "Hang tight — we're opening your application for community review."
msgstr ""
"Espera un momento: estamos abriendo tu solicitud para su revisión por la "
"comunidad."

#: includes/Artist/AdmissionConfirm.php:115
#: includes/Artist/AdmissionNotification.php:404
msgid "Confirm my application"
msgstr "Confirmar mi solicitud"

#: includes/Artist/AdmissionConfirm.php:153
msgid ""
"This community is currently full, so your application has joined the "
"waitlist — when a member leaves, the next person in line is welcomed in."
msgstr ""
"Esta comunidad está completa por el momento, así que tu solicitud se ha "
"añadido a la lista de espera; cuando salga un miembro, se dará la bienvenida "
"a la siguiente persona en la cola."

#: includes/Artist/AdmissionConfirm.php:154
msgid ""
