msgstr ""
"Alle synchronisatie voltooid: %1$d term(en) verwerkt, %2$d vertaling(en) "
"aangemaakt, %3$d aangemaakt als onvertaalde tijdelijke aanduidingen (AI-"
"vertaling was hiervoor niet beschikbaar) — bewerk ze in deze lijst om de "
"juiste naam toe te voegen, %4$d al up-to-date."

#. translators: 1: number of primary-language terms processed, 2: number of newly-created translated terms, 3: number of languages that already had one
#: includes/Admin/TaxonomyLanguageFilter.php:505
#, php-format
msgid ""
"Sync all complete: %1$d term(s) processed, %2$d translation(s) created, %3$d "
"already up to date."
msgstr ""
"Volledige synchronisatie voltooid: %1$d term(en) verwerkt, %2$d "
"vertaling(en) aangemaakt, %3$d al up-to-date."

#. translators: 1: number of newly-created translated terms, 2: number of terms created as untranslated placeholders needing a hand edit, 3: number of languages that already had one, 4: number of languages the translation could not be created for at all
#: includes/Admin/TaxonomyLanguageFilter.php:530
#, php-format
msgid ""
"Sync complete: %1$d translation(s) created, %2$d created as placeholders "
"needing translation, %3$d language(s) already up to date, %4$d failed "
"outright — check the AI provider configuration and try again."
msgstr ""
"Synchronisatie voltooid: %1$d vertaling(en) aangemaakt, %2$d aangemaakt als "
"tijdelijke aanduidingen die nog vertaald moeten worden, %3$d taal/talen al "
"up-to-date, %4$d volledig mislukt — controleer de configuratie van de AI-"
"provider en probeer het opnieuw."

#. translators: 1: number of newly-created translated terms, 2: number of terms created as untranslated placeholders needing a hand edit, 3: number of languages that already had one
#: includes/Admin/TaxonomyLanguageFilter.php:539
#, php-format
msgid ""
"Sync complete: %1$d translation(s) created, %2$d created as untranslated "
"placeholders (AI translation wasn't available for these) — edit them in this "
"list to add the correct name, %3$d language(s) already up to date."
msgstr ""
"Synchronisatie voltooid: %1$d vertaling(en) aangemaakt, %2$d aangemaakt als "
"onvertaalde tijdelijke aanduidingen (AI-vertaling was hiervoor niet "
"beschikbaar) — bewerk ze in deze lijst om de juiste naam toe te voegen, %3$d "
"taal/talen al up-to-date."

#. translators: 1: number of newly-created translated terms, 2: number of languages that already had one
#: includes/Admin/TaxonomyLanguageFilter.php:547
#, php-format
msgid ""
"Sync complete: %1$d translation(s) created, %2$d language(s) already up to "
"date."
msgstr ""
"Synchronisatie voltooid: %1$d vertaling(en) aangemaakt, %2$d taal/talen al "
"up-to-date."

#: includes/AI/PromptConfig.php:268
msgid ""
"The artist sent no subject line or message with this submission — let the "
"image speak entirely for itself."
msgstr ""
"De kunstenaar heeft geen onderwerpregel of bericht meegestuurd met deze "
"inzending — laat het beeld volledig voor zichzelf spreken."

#: includes/Artist/Admission.php:108 includes/Artist/ContactForm.php:164
#: includes/Network/ActivityPub.php:442
msgid "Name"
msgstr "Naam"

#: includes/Artist/Admission.php:113
#: includes/Artist/AdmissionNotification.php:514
#: includes/Artist/AdmissionNotification.php:609
msgid "Bio"
msgstr "Bio"

#: includes/Artist/Admission.php:122
#: includes/Artist/AdmissionNotification.php:524
#: includes/Artist/AdmissionNotification.php:619
msgid "Statement"
msgstr "Statement"

#. translators: 1: field name (e.g. "Name", "Bio", "Message"), 2: maximum character count
#: includes/Artist/Admission.php:178 includes/Artist/ContactForm.php:203
#: includes/Network/ActivityPub.php:3964
#, php-format
msgid "%1$s must be %2$d characters or fewer."
msgstr "%1$s mag %2$d tekens of minder zijn."

#: includes/Artist/Admission.php:228 includes/Artist/JoinPage.php:217
msgid "Please select your language."
msgstr "Selecteer je taal."

#: includes/Artist/Admission.php:237
msgid "An account with this email address already exists."
msgstr "Er bestaat al een account met dit e-mailadres."

#: includes/Artist/Admission.php:261
msgid "This email address belongs to an admitted artist."
msgstr "Dit e-mailadres hoort bij een toegelaten kunstenaar."

#: includes/Artist/Admission.php:262
msgid "An application for this email address is already pending."
msgstr "Er is al een aanvraag in behandeling voor dit e-mailadres."

#: includes/Artist/Admission.php:609 includes/Artist/Admission.php:717
msgid "Application not found."
msgstr "Aanvraag niet gevonden."

#: includes/Artist/Admission.php:649
msgid "Only admitted artists can vouch."
msgstr "Alleen toegelaten kunstenaars kunnen aanbevelingen doen."

#: includes/Artist/Admission.php:659
msgid "Admin access required."
msgstr "Admin-toegang vereist."

#: includes/Artist/Admission.php:698
msgid ""
"Community voting is disabled on this site. Applications are reviewed "
"directly by an admin."
msgstr ""
"Communitystemming is uitgeschakeld op deze site. Aanvragen worden direct "
"door een admin beoordeeld."

#: includes/Artist/Admission.php:731
msgid "You cannot vote on your own application."
msgstr "Je kunt niet op je eigen aanvraag stemmen."

#: includes/Artist/AdmissionConfirm.php:64
#: includes/Newsletter/SubscriptionConfirm.php:82
#: includes/Newsletter/SubscriptionConfirm.php:139
msgid "Invalid or incomplete link."
msgstr "Ongeldige of onvolledige link."

#: includes/Artist/AdmissionConfirm.php:80
#: includes/Newsletter/SubscriptionConfirm.php:158
msgid "This confirmation link is invalid or has already been used."
msgstr "Deze bevestigingslink is ongeldig of is al gebruikt."

#: includes/Artist/AdmissionConfirm.php:113
msgid "Confirming your application…"
msgstr "Je aanvraag wordt bevestigd…"

#: includes/Artist/AdmissionConfirm.php:114
msgid "Hang tight — we're opening your application for community review."
msgstr ""
"Even geduld — we openen je aanvraag voor beoordeling door de community."

#: includes/Artist/AdmissionConfirm.php:115
#: includes/Artist/AdmissionNotification.php:404
msgid "Confirm my application"
msgstr "Mijn aanvraag bevestigen"

#: includes/Artist/AdmissionConfirm.php:153
