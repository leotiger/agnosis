msgid "View it live"
msgstr "Bekijk live"

#: includes/Publishing/ReviewConfirm.php:320
msgid "Biography published"
msgstr "Bio gepubliceerd"

#: includes/Publishing/ReviewConfirm.php:320
msgid "Your biography has been published."
msgstr "Je bio is gepubliceerd."

#: includes/Publishing/ReviewConfirm.php:321
msgid "Event published"
msgstr "Evenement gepubliceerd"

